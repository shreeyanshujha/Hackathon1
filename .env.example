# ---- demo safety -------------------------------------------------------
DEMO_MODE=1                 # clamps every call timeout to 10s
CALL_PROVIDER=dryrun        # dryrun | elevenlabs
PRODUCT_NAME=Halo

# ---- transcript classifier --------------------------------------------
# Without a key the deterministic fallback runs instead. The fallback can
# never return resolved_ok or declined, so the ladder still fails upward.
ANTHROPIC_API_KEY=
# Either credential switches the real classifier on: the SDK resolves the key,
# this token, or a profile written by `ant auth login`. Set one, not both.
ANTHROPIC_AUTH_TOKEN=
CLASSIFIER_MODEL=claude-haiku-4-5

# ---- demo phone numbers ------------------------------------------------
JEFF_PHONE=+61400000001     # you, playing the user
JESS_PHONE=+61400000002     # teammate, playing kin #1
SUPPORT_PHONE=+61400000009  # second teammate, playing the on-call line

# ---- phase 3: ElevenLabs Conversational AI over Twilio -----------------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

TRANSITION_LOG=logs/transitions.jsonl
NO_COLOR=                   # set to anything to drop ANSI colour from the audit echo
ELEVENLABS_WEBHOOK_SECRET=
# Optional: a dedicated ElevenLabs agent per role. Without these, the single
# ELEVENLABS_AGENT_ID is reused and the prompt is overridden per call (which
# requires prompt.prompt and first_message overrides to be enabled in the
# agent's Security settings).
ELEVENLABS_AGENT_ID_USER=
ELEVENLABS_AGENT_ID_KIN=
ELEVENLABS_AGENT_ID_SUPPORT=
CLASSIFIER_TIMEOUT=5        # seconds; falls back to the rule classifier past this
