# Twilio Programmable Voice + SMS credentials (console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Overrides for the numbers in profiles.json (recommended for demos:
# point every profile at your real test phones)
KIN_NUMBER=+1XXXXXXXXXX
RESPONDER_NUMBER=+1XXXXXXXXXX

# Public HTTPS URL of this backend (cloudflared / ngrok tunnel).
# Twilio fetches TwiML from here, and the Fitbit companion posts here.
# No trailing slash.
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# STRONGLY recommended whenever PUBLIC_BASE_URL is a live tunnel: a random
# string that /ingest, /simulate, /state and /demo/* then require as an
# X-Api-Key header. Open the dashboard as http://localhost:8000/?key=THE_SECRET
# and set the same value as API_KEY in hackathon-app/companion/index.js.
# Leave empty for the zero-config local demo (no auth).
API_SHARED_SECRET=

# --- Fitbit Web API (the live watch card) ----------------------------------
# Register once at https://dev.fitbit.com/apps/new (sign in with the Google
# account the watch is paired to):
#   OAuth 2.0 Application Type: Personal   (intraday HR for your own account)
#   Callback URL:               http://localhost:8000/fitbit/callback
FITBIT_CLIENT_ID=
# Only needed if the app was registered as type Server; Personal/Client use
# PKCE and can leave this empty.
FITBIT_CLIENT_SECRET=
# Seconds between polls (Fitbit's limit is 150 requests/hour; 60s is safe).
FITBIT_POLL_SEC=60
# Override only if the backend is not on localhost:8000.
FITBIT_REDIRECT_URI=
